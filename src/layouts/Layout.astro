---
import "../styles/globals.css";
import { ViewTransitions } from 'astro:transitions';
import { Image } from 'astro:assets';

// Import zdjęć tła z folderu src/assets/
import tlo1 from "../assets/tlo1.jpg";
import tlo2 from "../assets/tlo2.jpg";
import tlo3 from "../assets/tlo3.jpg";

// Import logo z folderu src/assets/
import logoImg from "../assets/logo.png";

const { title = "Szczecin – Dąbie | Remonty i Smart Home" } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ViewTransitions />
  </head>

  <body class="bg-black text-white font-sans min-h-screen relative overflow-x-hidden">
    
    <div class="background-container">
      <div class="overlay"></div>
      <div class="slideshow">
        <Image src={tlo1} alt="Remonty 1" class="slide" loading="eager" />
        <Image src={tlo2} alt="Remonty 2" class="slide" />
        <Image src={tlo3} alt="Remonty 3" class="slide" />
      </div>
    </div>

    <header class="p-6 md:p-10 flex items-center justify-between relative z-50">
      <a href="/" class="logo-3d-container" transition:name="logo">
        <Image 
          src={logoImg} 
          alt="Logo" 
          class="h-20 md:h-28 w-auto logo-3d-media"
        />
      </a>

      {!isHome && (
        <a href="/" class="back-btn">
          <span>←</span> Wróć do menu
        </a>
      )}
    </header>

    <main class="relative z-20 container mx-auto px-6">
      <slot />
    </main>

    <style is:global>
      /* --- LOGO 3D --- */
      .logo-3d-container {
        display: inline-block;
        perspective: 1000px;
      }
      .logo-3d-media {
        display: block;
        animation: rotate360 12s linear infinite;
        transform-style: preserve-3d;
        filter: drop-shadow(0 0 15px rgba(255,255,255,0.1));
      }
      @keyframes rotate360 {
        from { transform: rotateY(0deg); }
        to { transform: rotateY(360deg); }
      }
      .logo-3d-container:hover .logo-3d-media {
        animation-play-state: paused;
      }

      /* --- PRZYCISK POWROTU --- */
      .back-btn {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        padding: 10px 20px;
        border-radius: 50px;
        color: white;
        text-decoration: none;
        font-weight: 500;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .back-btn:hover {
        background: rgba(255, 255, 255, 0.2);
        transform: translateX(-5px);
        border-color: #ffcc00; /* Złoty akcent przy hoverze */
      }

      /* --- TŁO SLIDER --- */
      .background-container {
        position: fixed;
        inset: 0;
        z-index: 1;
        background: #000;
      }
      .overlay {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle, transparent 20%, rgba(0,0,0,0.8) 100%);
        z-index: 10;
      }
      .slideshow {
        position: relative;
        width: 100%;
        height: 100%;
      }
      .slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        animation: crossfade 18s infinite;
      }
      .slide:nth-child(1) { animation-delay: 0s; }
      .slide:nth-child(2) { animation-delay: 6s; }
      .slide:nth-child(3) { animation-delay: 12s; }

      @keyframes crossfade {
        0% { opacity: 0; }
        10% { opacity: 1; }
        33% { opacity: 1; }
        45% { opacity: 0; }
        100% { opacity: 0; }
      }
    </style>
  </body>
</html>