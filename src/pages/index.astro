---
import Layout from "../layouts/Layout.astro";
---

<Layout>

  <!-- HERO VIDEO -->
  <section class="relative h-screen flex items-center justify-center text-center">

    <!-- VIDEO BACKGROUND -->
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      class="absolute inset-0 w-full h-full object-cover"
    >
      <source src="/video.mp4" type="video/mp4" />
    </video>

    <!-- CIEMNA NAKŁADKA -->
    <div class="absolute inset-0 bg-black/70"></div>

    <div class="relative z-10 max-w-4xl px-6 mx-auto">

      <h1 class="premium-heading text-3xl sm:text-4xl md:text-6xl mb-6 leading-tight">
        <span class="block">Szczecin – Dąbie</span>
        <span class="block mt-2">
          Remonty • Elektryka • Smart Home • Monitoring
        </span>
      </h1>

      <p class="strong-text text-lg md:text-xl mb-10">
        Działamy na Prawobrzeżu Szczecina:
        Dąbie, Zdroje, Podjuchy, Kijewo,
        Majowe, Bukowe.
        Profesjonalne remonty, instalacje 400V,
        montaż AGD oraz systemy inteligentnego domu.
      </p>

      <!-- PRZYCISKI -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">

        <a href="/uslugi"
           class="px-8 py-4 glass neon-border font-semibold text-white rounded-full transition hover:scale-105">
          Zobacz usługi
        </a>

        <a href="/kontakt"
           class="px-8 py-4 glass neon-border font-semibold text-white rounded-full transition hover:scale-105">
          Kontakt
        </a>

        <a href="/aplikacja-android"
           class="px-8 py-4 glass neon-border font-semibold text-white rounded-full transition hover:scale-105">
          Aplikacja Android
        </a>

      </div>

      <!-- CTA -->
      <a href="tel:+48725144019"
         class="px-8 py-4 bg-cyan-400 hover:bg-cyan-300 rounded-full font-bold text-black transition shadow-lg">
        Zadzwoń: 725 144 019
      </a>

    </div>

  </section>


  <!-- SEKCJA KAFELKÓW -->
  <section class="section">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 max-w-7xl mx-auto">

      <a href="/bezpieczenstwo-instalacji" class="glass p-8 text-center block">
        <div class="text-4xl mb-4">⚡</div>
        <h3 class="strong-text-bold text-xl mb-3">
          Bezpieczeństwo instalacji
        </h3>
        <p class="strong-text">
          Instalacje 230V i 400V (siła), podłączanie płyt,
          AGD, gniazdek, oświetlenia i Smart Home.
        </p>
      </a>

      <a href="/kompleksowe-remonty" class="glass p-8 text-center block">
        <div class="text-4xl mb-4">🛠</div>
        <h3 class="strong-text-bold text-xl mb-3">
          Kompleksowe remonty
        </h3>
        <p class="strong-text">
          Malowanie, tynkowanie, montaż drzwi,
          listew, mebli oraz lekkie prace hydrauliczne.
        </p>
      </a>

      <a href="/nowoczesna-automatyka" class="glass p-8 text-center block">
        <div class="text-4xl mb-4">📡</div>
        <h3 class="strong-text-bold text-xl mb-3">
          Nowoczesna automatyka
        </h3>
        <p class="strong-text">
          Monitoring IP, wideodomofony,
          integracja systemów oraz systemy automatyki budynkowej.
        </p>
      </a>

      <a href="/aplikacja-android"
         class="glass p-8 text-center block">
        <div class="text-4xl mb-4">📱</div>
        <h3 class="strong-text-bold text-xl mb-3">
          Aplikacja Android
        </h3>
        <p class="strong-text">
          Dedykowana aplikacja do zarządzania
          usługami i systemami inteligentnego domu.
        </p>
      </a>

      <!-- STRONY I APLIKACJE -->
      <a href="https://legalofficeassistance.github.io/start-online/start-online.html"
         target="_blank"
         rel="noopener noreferrer"
         class="glass p-8 text-center block md:col-span-2 lg:col-span-4">
        <div class="text-4xl mb-4">💻</div>
        <h3 class="strong-text-bold text-2xl mb-4">
          Budujemy także strony internetowe i aplikacje mobilne na Androida
        </h3>
        <p class="strong-text text-lg">
          Tworzymy nowoczesne strony www, systemy online oraz aplikacje mobilne.
          Kliknij, aby zobaczyć przykład realizacji.
        </p>
      </a>

    </div>
  </section>


  <!-- KONTAKT -->
  <section class="section text-center glass p-8 max-w-4xl mx-auto mt-12">

    <h2 class="premium-heading text-3xl mb-6">
      Kontakt
    </h2>

    <p class="strong-text mb-3">
      📞 Telefon:
      <a href="tel:+48725144019" class="font-bold underline underline-offset-4">
        725 144 019
      </a>
    </p>

    <p class="strong-text mb-3">
      💬 WhatsApp / Telegram: +36 70 265 5296
    </p>

    <p class="strong-text">
      ✉ Email:
      <a href="mailto:buduje.remontuje.szczecin@gmail.com"
         class="font-bold underline underline-offset-4">
         buduje.remontuje.szczecin@gmail.com
      </a>
    </p>

  </section>


  <!-- PŁYWAJĄCE PRZYCISKI -->

  <a href="tel:+48725144019"
     class="fixed bottom-6 right-6 bg-cyan-400 hover:bg-cyan-300 text-black w-14 h-14 rounded-full flex items-center justify-center text-2xl shadow-lg z-50">
    📞
  </a>

  <a href="https://wa.me/36702655296"
     target="_blank"
     class="fixed bottom-24 right-6 bg-green-500 hover:bg-green-400 text-white w-14 h-14 rounded-full flex items-center justify-center text-2xl shadow-lg z-50">
    💬
  </a>

  <a href="https://t.me/+36702655296"
     target="_blank"
     class="fixed bottom-40 right-6 bg-blue-500 hover:bg-blue-400 text-white w-14 h-14 rounded-full flex items-center justify-center text-2xl shadow-lg z-50">
    ✈
  </a>

</Layout>
